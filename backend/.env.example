# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Postgres — pooled connection string (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# Upstash Redis — leave blank locally to fall back to an in-memory cache
REDIS_URL=

# Clerk — Dashboard > API Keys > Advanced > JWKS URL / Issuer
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>

# OpenRouteService — dashboard.openrouteservice.org > Dev Dashboard > Request a token
# Used for driving-hgv routing, geocoding, and autocomplete.
ORS_API_KEY=

# CORS — the frontend origin(s) allowed to call this API. Same-origin on
# Vercel, so this only matters for local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173
